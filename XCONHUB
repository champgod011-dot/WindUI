local Tab = Window:Tab({Title="ESP / Warp / Jump", Icon="info"})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- ---------- ESP ----------
local espEnabled = false
local espObjects = {}
local itemColors = {Pistol=Color3.fromRGB(255,255,0),Rifle=Color3.fromRGB(0,255,255),Shotgun=Color3.fromRGB(255,100,100)}

local function getHeldItem(player)
    local char = player.Character
    if not char then return nil end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return nil end
    return tool.Name, itemColors[tool.Name] or Color3.fromRGB(255,255,255)
end

local function createESP(player)
    if not espEnabled or not player.Character then return end
    local char = player.Character
    local head = char:FindFirstChild("Head")
    if not head then return end

    -- ลบ ESP เก่า
    if espObjects[player] then
        for _, o in ipairs(espObjects[player]) do o:Destroy() end
    end
    espObjects[player] = {}

    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = (player.Team == LocalPlayer.Team) and Color3.fromRGB(0,0,255) or Color3.fromRGB(255,0,0)
    highlight.Parent = Workspace
    table.insert(espObjects[player], highlight)

    -- Billboard
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = head
    billboard.Size = UDim2.new(0,150,0,45)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    table.insert(espObjects[player], billboard)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1,0,0.33,0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.TextStrokeTransparency = 0.2
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 14
    nameLabel.Parent = billboard

    local itemLabel = Instance.new("TextLabel")
    itemLabel.Size = UDim2.new(1,0,0.33,0)
    itemLabel.Position = UDim2.new(0,0,0.33,0)
    itemLabel.BackgroundTransparency = 1
    itemLabel.TextStrokeTransparency = 0.2
    itemLabel.Font = Enum.Font.SourceSansBold
    itemLabel.TextSize = 13
    itemLabel.Parent = billboard

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1,0,0.33,0)
    infoLabel.Position = UDim2.new(0,0,0.66,0)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(255,255,255)
    infoLabel.TextStrokeTransparency = 0.3
    infoLabel.Font = Enum.Font.SourceSansBold
    infoLabel.TextSize = 13
    infoLabel.Parent = billboard

    -- อัปเดตเรียลไทม์
    task.spawn(function()
        while espEnabled and player and player.Character do
            local humanoid = char:FindFirstChildWhichIsA("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local itemName, itemColor = getHeldItem(player)
            if itemName then
                itemLabel.Text = itemName
                itemLabel.TextColor3 = itemColor
            else itemLabel.Text = "" end
            if humanoid and hrp and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hp = math.floor(humanoid.Health)
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                infoLabel.Text = "HP: "..hp.." | "..dist.."m"
            end
            task.wait(0.1)
        end
    end)
end

-- สร้าง ESP ให้ผู้เล่นทั้งหมด และ respawn
local function setupPlayerESP(player)
    player.CharacterAdded:Connect(function()
        if espEnabled then
            createESP(player)
        end
    end)
    if espEnabled and player.Character then
        createESP(player)
    end
end

for _, p in pairs(Players:GetPlayers()) do
    setupPlayerESP(p)
end

Players.PlayerAdded:Connect(function(p)
    setupPlayerESP(p)
end)

Tab:Toggle({Title="ESP", Default=false, Callback=function(state)
    espEnabled = state
    if state then
        for _, p in pairs(Players:GetPlayers()) do
            createESP(p)
        end
    else
        for _, objs in pairs(espObjects) do
            for _, o in ipairs(objs) do o:Destroy() end
        end
        espObjects = {}
    end
end})

-- ---------- Warp ----------
local WarpEnabled = false
local warpDistance = 0.4
local warpCooldown = 0.05
local lastWarp = 0

RunService.Heartbeat:Connect(function()
    if not WarpEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    if tick() - lastWarp >= warpCooldown then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * warpDistance
            lastWarp = tick()
        end
    end
end)

Tab:Toggle({Title="Warp", Default=false, Callback=function(state) WarpEnabled = state end})

Tab:Slider({
    Title = "Warp Speed",
    Step = 0.05,
    Width = 200,
    Value = {Min = 0.1, Max = 5, Default = warpDistance},
    Callback = function(value)
        warpDistance = value
    end
})

-- ---------- Jump Boost ----------
local JumpEnabled = false
local jumpPower = 50 -- default

Tab:Toggle({Title="Jump Boost", Default=false, Callback=function(state)
    JumpEnabled = state
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid") then
        LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid").JumpPower = jumpPower
    end
end})

Tab:Slider({
    Title = "Jump Power",
    Step = 1,
    Width = 200,
    Value = {Min = 50, Max = 500, Default = jumpPower},
    Callback = function(value)
        jumpPower = value
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid") then
            LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid").JumpPower = value
        end
    end
})

-- รีเซ็ต JumpPower ตอน respawn
LocalPlayer.CharacterAdded:Connect(function(char)
    if JumpEnabled then
        local humanoid = char:WaitForChild("Humanoid")
        humanoid.JumpPower = jumpPower
    end
end)
