local Window = WindUI:CreateWindow({
    Title = ".xcon hub  |  WindUI",
    Author = "dc | discord.gg/P8qVhXfE",
    Folder = "xconhub",
    Icon = "map",
    IconSize = 44,
    NewElements = true,
    HideSearchBar = false,
    OpenButton = {
        Title = "xcon hub UI",
        CornerRadius = UDim.new(1,0),
        StrokeThickness = 3,
        Enabled = true,
        Draggable = true,
        Color = ColorSequence.new(Color3.fromHex("#30FF6A"), Color3.fromHex("#e7ff2f"))
    }
