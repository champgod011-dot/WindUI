--============================--
--          Services
--============================--
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Workspace = game:GetService("Workspace")

--============================--
--          Silent Aim Tab
--============================--
local SilentAimTab = Window:Tab({Title="Silent Aim", Icon="locate"})
local SilentAimEnabled = false
local TracerEnabled = true
local FOV = 150
local PREDICTION_FACTOR = 0.165
local CurrentTarget
local aimPart, aimPos

local GunNames = {"P226","MP5","M24","Draco","Glock","Sawnoff","Uzi","G3","C9","Hunting Rifle","Anaconda","AK47","Remington","Double Barrel"}
local GunLookup = {}
for _, v in ipairs(GunNames) do GunLookup[v] = true end

-- FOV Circle
local fovCircle = Drawing.new("Circle")
fovCircle.Color = Color3.new(1,1,1)
fovCircle.Thickness = 2
fovCircle.NumSides = 100
fovCircle.Radius = FOV
fovCircle.Filled = false
fovCircle.Visible = false

-- Tracer line
local tracerLine = Drawing.new("Line")
tracerLine.Color = Color3.new(1,0,0)
tracerLine.Thickness = 2
tracerLine.Visible = false

-- FUNCTIONS
local function GetClosestTarget()
    local closest
    local shortest = math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local screenPos, inView = Camera:WorldToViewportPoint(head.Position)
                if inView then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < FOV and dist < shortest then
                        shortest = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function PredictHeadPosition(player)
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    local vel = hrp and hrp.Velocity or Vector3.new()
    return head.Position + vel * PREDICTION_FACTOR
end

local function IsHoldingAllowedGun(args)
    local ok, weapon = pcall(function() return args[3] end)
    if ok and typeof(weapon)=="Instance" and GunLookup[weapon.Name] then
        return true
    end
    for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
        if (tool:IsA("Tool") or tool:IsA("Model")) and GunLookup[tool.Name] then
            return true
        end
    end
    return false
end

-- Hook Fire
local send = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Send")
local oldFire = hookfunction(send.FireServer, function(self, ...)
    local args = {...}
    if SilentAimEnabled and IsHoldingAllowedGun(args) then
        CurrentTarget = GetClosestTarget()
        if CurrentTarget and CurrentTarget.Character then
            local head = CurrentTarget.Character:FindFirstChild("Head")
            if head then
                aimPart = head
                aimPos = PredictHeadPosition(CurrentTarget)
                args[4] = CFrame.new(math.huge, math.huge, math.huge)
                args[5] = {[1] = {[1] = {["Instance"]=aimPart, ["Position"]=aimPos}}}
            end
        end
    end
    return oldFire(self, unpack(args))
end)

-- RenderStepped
RunService.RenderStepped:Connect(function()
    -- FOV
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    fovCircle.Radius = FOV
    fovCircle.Visible = SilentAimEnabled

    -- Tracer
    if TracerEnabled and SilentAimEnabled then
        local t = GetClosestTarget()
        if t and t.Character then
            local pos = PredictHeadPosition(t)
            local screen, onScreen = Camera:WorldToViewportPoint(pos)
            if onScreen then
                tracerLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                tracerLine.To = Vector2.new(screen.X, screen.Y)
                tracerLine.Visible = true
            else
                tracerLine.Visible = false
            end
        else
            tracerLine.Visible = false
        end
    else
        tracerLine.Visible = false
    end
end)

-- UI
SilentAimTab:Toggle({Title="Silent Aim", Default=false, Callback=function(state) SilentAimEnabled=state end})
SilentAimTab:Toggle({Title="Tracer", Default=true, Callback=function(state) TracerEnabled=state end})
SilentAimTab:Slider({Title="FOV", Step=1, Width=200, Value={Min=50,Max=500,Default=150}, Callback=function(value) FOV=value end})

--============================--
--          Anti-Aim Tab
--============================--
local AntiAimTab = Window:Tab({Title="Anti Aim", Icon="info"})
local AntiAimEnabled = false
local AntiAimMode = "Spin"
local RotationSpeed = 36
local DodgeChance = 85
local JitterAmount = 25
local WiggleAmount = 2
local currentAngle = 0

AntiAimTab:Toggle({Title="Anti Aim Pro", Default=false, Callback=function(state) AntiAimEnabled=state end})
AntiAimTab:Dropdown({Title="Mode", Default="Spin", Options={"Spin","Jitter","Random","Wiggle"}, Callback=function(mode) AntiAimMode=mode end})
AntiAimTab:Slider({Title="Rotation Speed (deg/s)", Step=1, Width=200, Value={Min=1,Max=360,Default=36}, Callback=function(value) RotationSpeed=value end})
AntiAimTab:Slider({Title="Dodge Chance (%)", Step=1, Width=200, Value={Min=0,Max=100,Default=85}, Callback=function(value) DodgeChance=value end})
AntiAimTab:Slider({Title="Jitter Amount (deg)", Step=1, Width=200, Value={Min=0,Max=50,Default=25}, Callback=function(value) JitterAmount=value end})
AntiAimTab:Slider({Title="Wiggle Amount", Step=0.1, Width=200, Value={Min=0,Max=5,Default=2}, Callback=function(value) WiggleAmount=value end})

RunService.RenderStepped:Connect(function(dt)
    if AntiAimEnabled and LocalPlayer.Character then
        local HRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if HRP then
            local dodge = math.random() < (DodgeChance/100)
            local angleStep = math.rad(RotationSpeed * dt)
            local originalPos = HRP.Position

            if AntiAimMode=="Spin" then
                if dodge then
                    local jitter = math.rad(math.random(-JitterAmount*100,JitterAmount*100)/100)
                    currentAngle = currentAngle + angleStep + jitter
                else
                    currentAngle = currentAngle + angleStep
                end
                HRP.CFrame = CFrame.new(originalPos) * CFrame.Angles(0,currentAngle,0)
            elseif AntiAimMode=="Jitter" then
                local jitter = math.rad(math.random(-JitterAmount*100,JitterAmount*100)/100)
                currentAngle = currentAngle + jitter
                HRP.CFrame = CFrame.new(originalPos) * CFrame.Angles(0,currentAngle,0)
            elseif AntiAimMode=="Random" then
                local randomAngle = math.rad(math.random(-180,180))
                HRP.CFrame = CFrame.new(originalPos) * CFrame.Angles(0,randomAngle,0)
            elseif AntiAimMode=="Wiggle" then
                local offset = math.sin(tick()*5) * WiggleAmount
                HRP.CFrame = CFrame.new(originalPos + Vector3.new(offset,0,0)) * CFrame.Angles(0,currentAngle,0)
                currentAngle = currentAngle + angleStep
            end
        end
    end
end)

--============================--
--           ESP Tab
--============================--
local ESPTab = Window:Tab({Title="ESP", Icon="info"})
local espEnabled = false
local espObjects = {}
local itemColors = {Pistol=Color3.fromRGB(255,255,0),Rifle=Color3.fromRGB(0,255,255),Shotgun=Color3.fromRGB(255,100,100)}

local function getHeldItem(player)
    local char = player.Character
    if not char then return nil end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return nil end
    return tool.Name, itemColors[tool.Name] or Color3.fromRGB(255,255,255)
end

local function createESP(player)
    if not espEnabled or not player.Character then return end
    local char = player.Character
    local head = char:FindFirstChild("Head")
    if not head then return end
    if espObjects[player] then for _, o in ipairs(espObjects[player]) do o:Destroy() end end
    espObjects[player] = {}

    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(0,255,0)
    highlight.Parent = Workspace
    table.insert(espObjects[player], highlight)

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = head
    billboard.Size = UDim2.new(0,150,0,45)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    table.insert(espObjects[player], billboard)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1,0,0.33,0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.TextStrokeTransparency = 0.2
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 14
    nameLabel.Parent = billboard

    local itemLabel = Instance.new("TextLabel")
    itemLabel.Size = UDim2.new(1,0,0.33,0)
    itemLabel.Position = UDim2.new(0,0,0.33,0)
    itemLabel.BackgroundTransparency = 1
    itemLabel.TextStrokeTransparency = 0.2
    itemLabel.Font = Enum.Font.SourceSansBold
    itemLabel.TextSize = 13
    itemLabel.Parent = billboard

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1,0,0.33,0)
    infoLabel.Position = UDim2.new(0,0,0.66,0)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(255,255,255)
    infoLabel.TextStrokeTransparency = 0.3
    infoLabel.Font = Enum.Font.SourceSansBold
    infoLabel.TextSize = 13
    infoLabel.Parent = billboard

    task.spawn(function()
        while espEnabled and player and player.Character do
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildWhichIsA("Humanoid")
            local itemName, itemColor = getHeldItem(player)
            if itemName then itemLabel.Text = itemName itemLabel.TextColor3 = itemColor else itemLabel.Text="" end
            if humanoid and root and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hp = math.floor(humanoid.Health)
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
                infoLabel.Text = "HP: "..hp.." | "..dist.."m"
            end
            task.wait(0.1)
        end
    end)
end

Players.PlayerAdded:Connect(function(p)
    if espEnabled then createESP(p) end
end)

ESPTab:Toggle({Title="ESP", Default=false, Callback=function(state)
    espEnabled = state
    if state then for _, p in pairs(Players:GetPlayers()) do if p~=LocalPlayer then createESP(p) end end
    else for _, objs in pairs(espObjects) do for _, o in ipairs(objs) do o:Destroy() end end end
end})

--============================--
--           Warp Tab
--============================--
local WarpTab = Window:Tab({Title="Warp", Icon="info"})
local WarpEnabled = false
local warpDistance = 0.4
local warpCooldown = 0.05
local lastWarp = 0

RunService.Heartbeat:Connect(function()
    if not WarpEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    if tick() - lastWarp >= warpCooldown then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * warpDistance
            lastWarp = tick()
        end
    end
end)

WarpTab:Toggle({Title="Warp", Default=false, Callback=function(state) WarpEnabled=state end})
