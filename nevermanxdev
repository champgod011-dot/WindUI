local function RemoveESP(player)

local esp = ESPCache[player]

if esp then

if esp.Name and esp.Name.Parent then
esp.Name.Parent:Destroy()
end

if esp.Info and esp.Info.Parent then
esp.Info.Parent:Destroy()
end

ESPCache[player] = nil

end

end

