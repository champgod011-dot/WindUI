-- ESP
-- ============================ --
local function getHeldItem(player)
    local char = player.Character
    if not char then return nil end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return nil end
    return tool.Name, itemColors[tool.Name] or Color3.fromRGB(255,255,255)
end

local function createESP(player)
    if not espEnabled or not player.Character or player == LocalPlayer then return end
    local char = player.Character
    local head = char:FindFirstChild("Head")
    if not head then return end

    if espObjects[player] then
        for _, o in ipairs(espObjects[player]) do o:Destroy() end
    end
    espObjects[player] = {}

    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = (player.Team == LocalPlayer.Team) and Color3.fromRGB(0,0,255) or Color3.fromRGB(255,0,0)
    highlight.Parent = workspace
    table.insert(espObjects[player], highlight)

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = head
    billboard.Size = UDim2.new(0,150,0,45)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    table.insert(espObjects[player], billboard)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1,0,0.33,0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.TextStrokeTransparency = 0.2
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 14
    nameLabel.Parent = billboard

    local itemLabel = Instance.new("TextLabel")
    itemLabel.Size = UDim2.new(1,0,0.33,0)
    itemLabel.Position = UDim2.new(0,0,0.33,0)
    itemLabel.BackgroundTransparency = 1
    itemLabel.TextStrokeTransparency = 0.2
    itemLabel.Font = Enum.Font.SourceSansBold
    itemLabel.TextSize = 13
    itemLabel.Parent = billboard

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1,0,0.33,0)
    infoLabel.Position = UDim2.new(0,0,0.66,0)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(255,255,255)
    infoLabel.TextStrokeTransparency = 0.3
    infoLabel.Font = Enum.Font.SourceSansBold
    infoLabel.TextSize = 13
    infoLabel.Parent = billboard

    task.spawn(function()
        while espEnabled and player and player.Character and player ~= LocalPlayer do
            local humanoid = char:FindFirstChildWhichIsA("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local itemName, itemColor = getHeldItem(player)
            if itemName then
                itemLabel.Text = itemName
                itemLabel.TextColor3 = itemColor
            else
                itemLabel.Text = ""
            end
            if humanoid and hrp and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hp = math.floor(humanoid.Health)
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                infoLabel.Text = "HP: "..hp.." | "..dist.."m"
            end
            task.wait(0.1)
        end
    end)
end

local function setupPlayerESP(player)
    player.CharacterAdded:Connect(function()
        if espEnabled and player ~= LocalPlayer then
            createESP(player)
        end
    end)
    if espEnabled and player.Character and player ~= LocalPlayer then
        createESP(player)
    end
end

for _, p in pairs(Players:GetPlayers()) do
    setupPlayerESP(p)
end
Players.PlayerAdded:Connect(setupPlayerESP)

-- ============================ --
-- ANTI-AIM แบบหมุนตัวเร็วสุด
-- ============================ --
local antiAimGyro
local function setupAntiAim()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart")
    if not antiAimGyro then
        antiAimGyro = Instance.new("BodyGyro")
        antiAimGyro.P = 1e5
        antiAimGyro.D = 1e3
        antiAimGyro.MaxTorque = Vector3.new(0, math.huge, 0)
        antiAimGyro.CFrame = hrp.CFrame
        antiAimGyro.Parent = hrp
    end
end

-- ============================ --
-- MAIN LOOP
-- ============================ --
RunService.RenderStepped:Connect(function(deltaTime)
    -- FOV Circle
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    fovCircle.Radius = FOV
    fovCircle.Visible = SilentAimEnabled

    -- Tracer
    if TracerEnabled then
        local t = GetClosestTarget()
        if t and t.Character then
            local pos = PredictTargetPosition(t.Character)
            local screen, onScreen = Camera:WorldToViewportPoint(pos)
            if onScreen then
                tracerLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                tracerLine.To = Vector2.new(screen.X, screen.Y)
                tracerLine.Visible = true
            else tracerLine.Visible = false end
        else tracerLine.Visible = false end
    else
        tracerLine.Visible = false
    end

    -- Anti-Aim
    if AntiAimEnabled then
        setupAntiAim()
        if antiAimGyro then
            local spinThisFrame = math.min(MAX_SPIN_SPEED * deltaTime, MAX_SPIN_SPEED)
            antiAimGyro.CFrame = antiAimGyro.CFrame * CFrame.Angles(0, math.rad(spinThisFrame), 0)
        end
    elseif antiAimGyro then
        antiAimGyro:Destroy()
        antiAimGyro = nil
    end
end)

-- ============================ --
-- WARP
-- ============================ --
RunService.Heartbeat:Connect(function()
    if not WarpEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    if tick() - lastWarp >= warpCooldown then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.CFrame = CFrame.new(hrp.Position + hrp.CFrame.LookVector * warpDistance) * CFrame.Angles(0, math.rad(hrp.Orientation.Y), 0)
            lastWarp = tick()
        end
    end
end)

